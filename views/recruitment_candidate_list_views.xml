<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="recruitment_candidate_list_view_list" model="ir.ui.view">
            <field name="name">recruitment.candidate.list.list</field>
            <field name="model">recruitment.candidate.list</field>
            <field name="arch" type="xml">
                <list string="Liste des Candidats">
                    <field name="date_added"/>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="poste"/>
                    <field name="department_id"/>
                    <field name="batch_id" optional="show"/>
                    <field name="cv_attachment_id" optional="show"/>
                    <field name="added_by"/>
                    <field name="applicant_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="recruitment_candidate_list_view_form" model="ir.ui.view">
            <field name="name">recruitment.candidate.list.form</field>
            <field name="model">recruitment.candidate.list</field>
            <field name="arch" type="xml">
                <form string="Candidat">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_applicant" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-user">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Voir</span>
                                    <span class="o_stat_text">Candidature</span>
                                </div>
                            </button>
                        </div>
                        
                        <group>
                            <group string="Informations du Candidat">
                                <field name="name" readonly="1"/>
                                <field name="email" widget="email" readonly="1"/>
                                <field name="phone" widget="phone" readonly="1"/>
                                <field name="candidate_id" readonly="1"/>
                            </group>
                            <group string="Informations du Poste">
                                <field name="job_id" readonly="1"/>
                                <field name="poste" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="applicant_id" readonly="1"/>
                            </group>
                        </group>

                        <group string="Métadonnées">
                            <group>
                                <field name="date_added" readonly="1"/>
                                <field name="added_by" readonly="1"/>
                                <field name="batch_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="CV Principal">
                                <field name="cv_attachment_id" widget="many2one_binary" readonly="1"/>
                            </page>
                            
                            <page string="Tous les Documents">
                                <field name="candidate_attachment_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="mimetype"/>
                                        <field name="file_size" widget="integer"/>
                                        <field name="create_date"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Notes">
                                <field name="notes" placeholder="Ajoutez vos notes ici..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="recruitment_candidate_list_view_search" model="ir.ui.view">
            <field name="name">recruitment.candidate.list.search</field>
            <field name="model">recruitment.candidate.list</field>
            <field name="arch" type="xml">
                <search string="Rechercher Candidats">
                    <field name="name" string="Nom" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="email" string="Email"/>
                    <field name="phone" string="Téléphone"/>
                    <field name="poste" string="Poste"/>
                    <field name="department_id" string="Département"/>
                    <field name="job_id" string="Job"/>
                    <field name="batch_id" string="Lot"/>
                    
                    <separator/>
                    
                    <filter string="Ajouté Aujourd'hui" name="today" 
                            domain="[('date_added', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                    <filter string="Ajouté Cette Semaine" name="this_week" 
                            domain="[('date_added', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Ajouté Ce Mois" name="this_month" 
                            domain="[('date_added', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    
                    <separator/>
                    
                    <filter string="Dans un Lot" name="in_batch" domain="[('batch_id', '!=', False)]"/>
                    <filter string="Sans Lot" name="no_batch" domain="[('batch_id', '=', False)]"/>
                    
                    <separator/>
                    
                    <group expand="0" string="Grouper Par">
                        <filter string="Lot" name="group_batch" context="{'group_by': 'batch_id'}"/>
                        <filter string="Département" name="group_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Poste" name="group_job" context="{'group_by': 'job_id'}"/>
                        <filter string="Ajouté Par" name="group_added_by" context="{'group_by': 'added_by'}"/>
                        <filter string="Date d'Ajout" name="group_date" context="{'group_by': 'date_added'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="recruitment_candidate_list_view_kanban" model="ir.ui.view">
            <field name="name">recruitment.candidate.list.kanban</field>
            <field name="model">recruitment.candidate.list</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="poste"/>
                    <field name="department_id"/>
                    <field name="batch_id"/>
                    <field name="date_added"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="poste" widget="badge"/>
                                    <div t-if="record.department_id.value">
                                        <i class="fa fa-building-o"/> <field name="department_id"/>
                                    </div>
                                    <div t-if="record.batch_id.value">
                                        <i class="fa fa-folder-o"/> <field name="batch_id"/>
                                    </div>
                                    <div t-if="record.email.value">
                                        <i class="fa fa-envelope-o"/> <field name="email"/>
                                    </div>
                                    <div t-if="record.phone.value">
                                        <i class="fa fa-phone"/> <field name="phone"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="text-muted">
                                            <i class="fa fa-clock-o"/> <field name="date_added" widget="date"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="added_by" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="action_recruitment_candidate_list" model="ir.actions.act_window">
            <field name="name">Liste des Candidats</field>
            <field name="res_model">recruitment.candidate.list</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucun candidat ajouté à la liste
                </p>
                <p>
                    Utilisez le bouton "Ajouter à Liste" sur les candidatures pour ajouter des candidats ici.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
         <!--        <menuitem id="menu_recruitment_candidate_list"
                  name="Liste des Candidats"
                  parent="hr_recruitment.menu_hr_recruitment_root"
                  action="action_recruitment_candidate_list"
                  sequence="15"/>
                  
        -->

    </data>
</odoo>