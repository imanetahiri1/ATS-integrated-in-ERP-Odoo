<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Modern Kanban View for HR Department -->
        <record id="hr_department_view_kanban_modern" model="ir.ui.view">
            <field name="name">hr.department.kanban.modern</field>
            <field name="model">hr.department</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1" highlight_color="color">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="manager_id"/>
                    <field name="parent_id"/>
                    <field name="company_id"/>
                    <field name="total_employee"/>
                    <field name="active"/>
                    <field name="color"/>
                    <field name="logo"/>
                    <field name="email"/>
                    <field name="plusieur_poitage_period"/>
                    <field name="basculer_period"/>
                    
                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_card o_kanban_global_click" style="border-radius: 12px; border: 1px solid #e3f2fd; box-shadow: 0 2px 8px rgba(0,123,255,0.08); background: white;">
                                
                                <!-- Header -->
                                <div style="padding: 16px; border-bottom: 1px solid #f8f9fa;">
                                    <div style="display: flex; align-items: center; justify-content: space-between;">
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <!-- Logo or Icon -->
                                            <div style="width: 48px; height: 48px; border-radius: 8px; overflow: hidden; background: #e3f2fd; display: flex; align-items: center; justify-content: center;">
                                                <t t-if="record.logo.raw_value">
                                                    <img t-att-src="'/web/image/hr.department/' + record.id.raw_value + '/logo'" 
                                                         alt="Logo" 
                                                         style="width: 100%; height: 100%; object-fit: cover;"/>
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-sitemap" style="font-size: 24px; color: #1976d2;" title="Département"/>
                                                </t>
                                            </div>
                                            <div>
                                                <div style="font-weight: 600; color: #1a1a1a; font-size: 16px; margin-bottom: 2px;">
                                                    <field name="name"/>
                                                </div>
                                                <div t-if="record.parent_id.value" style="color: #6c757d; font-size: 13px;">
                                                    <field name="parent_id"/>
                                                </div>
                                                <div t-else="" style="color: #6c757d; font-size: 13px;">
                                                    Département principal
                                                </div>
                                            </div>
                                        </div>
                                        <div class="o_kanban_manage_button_section">
                                            <a class="o_kanban_manage_toggle_button" href="#" role="button" style="color: #6c757d;">
                                                <i class="fa fa-ellipsis-v" title="Options"/>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Content -->
                                <div style="padding: 16px;">
                                    <!-- Action Buttons -->
                                    <div class="o_kanban_card_manage_section o_kanban_manage_view" style="margin-bottom: 12px;">
                                        <div class="o_kanban_card_manage_section_buttons" style="gap: 8px;">
                                            <a type="edit" class="btn btn-primary btn-sm" role="button" style="border-radius: 6px;">
                                                Modifier
                                            </a>
                                            <a name="action_employee_from_department" type="object" class="btn btn-outline-primary btn-sm" role="button" style="border-radius: 6px;">
                                                Employés
                                            </a>
                                        </div>
                                    </div>
                                    
                                    <!-- Department Details -->
                                    <div style="display: grid; gap: 8px;">
                                        <!-- Manager -->
                                        <div t-if="record.manager_id.value" style="display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 24px; height: 24px; background: #fff3e0; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fa fa-user" style="font-size: 12px; color: #f57c00;" title="Manager"/>
                                            </div>
                                            <div>
                                                <span style="color: #6c757d; font-size: 12px;">Manager:</span>
                                                <span style="color: #1a1a1a; font-weight: 500; margin-left: 4px;"><field name="manager_id"/></span>
                                            </div>
                                        </div>
                                        
                                        <!-- No Manager -->
                                        <div t-else="" style="display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 24px; height: 24px; background: #ffebee; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fa fa-user-times" style="font-size: 12px; color: #f44336;" title="Pas de manager"/>
                                            </div>
                                            <div>
                                                <span style="color: #f44336; font-size: 12px; font-weight: 500;">Aucun manager assigné</span>
                                            </div>
                                        </div>

                                        <!-- Email -->
                                        <div t-if="record.email.value" style="display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 24px; height: 24px; background: #e3f2fd; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fa fa-envelope" style="font-size: 12px; color: #1976d2;" title="Email"/>
                                            </div>
                                            <div>
                                                <span style="color: #6c757d; font-size: 12px;">Email:</span>
                                                <span style="color: #1a1a1a; font-weight: 500; margin-left: 4px;"><field name="email"/></span>
                                            </div>
                                        </div>
                                        
                                        <!-- Employee Count -->
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 24px; height: 24px; background: #e8f5e8; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fa fa-users" style="font-size: 12px; color: #388e3c;" title="Employés"/>
                                            </div>
                                            <div>
                                                <span style="color: #6c757d; font-size: 12px;">Employés:</span>
                                                <span style="color: #1a1a1a; font-weight: 500; margin-left: 4px;">
                                                    <field name="total_employee"/> personne<span t-if="record.total_employee.raw_value != 1">s</span>
                                                </span>
                                            </div>
                                        </div>
                                        
                                        <!-- Company -->
                                        <div t-if="record.company_id.value" style="display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 24px; height: 24px; background: #f3e5f5; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fa fa-building" style="font-size: 12px; color: #7b1fa2;" title="Société"/>
                                            </div>
                                            <div>
                                                <span style="color: #6c757d; font-size: 12px;">Société:</span>
                                                <span style="color: #1a1a1a; font-weight: 500; margin-left: 4px;"><field name="company_id"/></span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Pointage Settings -->
                                    <div t-if="record.plusieur_poitage_period.raw_value or record.basculer_period.raw_value" style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #f8f9fa;">
                                        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                            <div t-if="record.plusieur_poitage_period.raw_value" style="display: inline-flex; align-items: center; gap: 4px; background: #e3f2fd; padding: 3px 6px; border-radius: 12px;">
                                                <i class="fa fa-check-circle" style="color: #1976d2; font-size: 10px;" title="Multi-pointage activé"/>
                                                <span style="color: #1976d2; font-size: 10px; font-weight: 500;">Multi-pointage</span>
                                            </div>
                                            <div t-if="record.basculer_period.raw_value" style="display: inline-flex; align-items: center; gap: 4px; background: #fff3e0; padding: 3px 6px; border-radius: 12px;">
                                                <i class="fa fa-check-circle" style="color: #f57c00; font-size: 10px;" title="Multi-période activé"/>
                                                <span style="color: #f57c00; font-size: 10px; font-weight: 500;">Multi-période</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- No Pointage Settings -->
                                    <div t-if="!record.plusieur_poitage_period.raw_value and !record.basculer_period.raw_value" style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #f8f9fa;">
                                        <div style="display: inline-flex; align-items: center; gap: 4px; background: #f8f9fa; padding: 3px 8px; border-radius: 12px;">
                                            <i class="fa fa-clock-o" style="color: #6c757d; font-size: 10px;" title="Pointage standard"/>
                                            <span style="color: #6c757d; font-size: 10px; font-weight: 500;">Pointage standard</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Rest of your views remain the same -->
        <!-- Enhanced HR Department Form View -->
        <record id="view_hr_department_form_inherit_pointage" model="ir.ui.view">
            <field name="name">hr.department.form.inherit.pointage</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <!-- Add logo at the top right corner -->
                <xpath expr="//sheet/div[@class='oe_button_box']" position="before">
                    <field name="logo" widget="image" class="oe_avatar" 
                           options="{'preview_image': 'logo', 'size': [90, 90]}"
                           style="float: right; margin-right: 10px;"/>
                </xpath>

                <!-- Add email field after manager -->
                <xpath expr="//field[@name='manager_id']" position="after">
                    <field name="email" widget="email" placeholder="departement@example.com"/>
                </xpath>

                <!-- Add Pointage Configuration Section -->
                <xpath expr="//sheet" position="inside">
                    <div style="background: white; padding: 24px; border-radius: 12px; margin-top: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                        <h3 style="color: #1a1a1a; font-size: 18px; font-weight: 600; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-clock-o" style="color: #e91e63;" title="Paramètres Pointage"/>
                            Paramètres de Pointage
                        </h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
                            <div>
                                <div class="o_form_label" style="color: #6c757d; font-size: 13px; font-weight: 500; margin-bottom: 8px; display: block;">Plusieurs pointages par période</div>
                                <field name="plusieur_poitage_period"/>
                                <div style="color: #9e9e9e; font-size: 12px; margin-top: 4px;">Autoriser plusieurs pointages dans une période pour un seul employé</div>
                            </div>
                            <div>
                                <div class="o_form_label" style="color: #6c757d; font-size: 13px; font-weight: 500; margin-bottom: 8px; display: block;">Pointage multi-périodes</div>
                                <field name="basculer_period"/>
                                <div style="color: #9e9e9e; font-size: 12px; margin-top: 4px;">Permet de faire des pointages dans plusieurs périodes en même temps</div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Enhanced HR Department List View -->
        <record id="view_hr_department_list_inherit_pointage" model="ir.ui.view">
            <field name="name">hr.department.list.inherit.pointage</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="logo" widget="image" width="40px" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='manager_id']" position="after">
                    <field name="email" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='color']" position="after">
                    <field name="plusieur_poitage_period" string="Multi-pointage" widget="boolean_toggle" optional="hide"/>
                    <field name="basculer_period" string="Multi-période" widget="boolean_toggle" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- Enhanced HR Department Search View -->
        <record id="view_hr_department_search_inherit_pointage" model="ir.ui.view">
            <field name="name">hr.department.search.inherit.pointage</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='manager_id']" position="after">
                    <field name="email"/>
                    <field name="plusieur_poitage_period" string="Multi-pointage"/>
                    <field name="basculer_period" string="Multi-période"/>
                </xpath>
                <xpath expr="//filter[@name='inactive']" position="after">
                    <separator/>
                    <filter string="Multi-pointage activé" name="filter_multi_pointage" 
                            domain="[('plusieur_poitage_period', '=', True)]"/>
                    <filter string="Multi-période activé" name="filter_multi_period" 
                            domain="[('basculer_period', '=', True)]"/>
                    <filter string="Paramètres avancés" name="filter_advanced_pointage" 
                            domain="['|', ('plusieur_poitage_period', '=', True), ('basculer_period', '=', True)]"/>
                    <separator/>
                    <filter string="Avec Manager" name="filter_with_manager" 
                            domain="[('manager_id', '!=', False)]"/>
                    <filter string="Sans Manager" name="filter_no_manager" 
                            domain="[('manager_id', '=', False)]"/>
                    <separator/>
                    <filter string="Par Manager" name="group_by_manager" 
                            context="{'group_by': 'manager_id'}"/>
                    <filter string="Par Société" name="group_by_company" 
                            context="{'group_by': 'company_id'}"/>
                    <filter string="Par Paramètres Pointage" name="group_by_pointage" 
                            context="{'group_by': 'plusieur_poitage_period'}"/>
                </xpath>
            </field>
        </record>

        <!-- Départements Action -->
        <record id="action_softy_departements" model="ir.actions.act_window">
            <field name="name">Gestion des Départements</field>
            <field name="res_model">hr.department</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[("has_read_access", "=", True)]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <div style="text-align: center; padding: 40px;">
                    <div style="margin-bottom: 20px;">
                        <i class="fa fa-sitemap fa-3x" style="color: #1976d2;"/>
                    </div>
                    <h2 style="color: #1a1a1a; font-weight: 600; margin-bottom: 12px;">
                        Créez votre premier département
                    </h2>
                    <p style="color: #6c757d; margin-bottom: 24px; max-width: 400px; margin-left: auto; margin-right: auto;">
                        Organisez votre entreprise en départements avec des paramètres de pointage personnalisés pour chaque équipe.
                    </p>
                </div>
            </field>
        </record>

        <!-- Action Window Views for Departments -->
        <record id="hr_department_kanban_view_action" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="hr_department_view_kanban_modern"/>
            <field name="act_window_id" ref="action_softy_departements"/>
        </record>

        <record id="hr_department_list_view_action" model="ir.actions.act_window.view">
            <field name="sequence" eval="20"/>
            <field name="view_mode">list</field>
            <field name="act_window_id" ref="action_softy_departements"/>
        </record>

        <record id="hr_department_form_view_action" model="ir.actions.act_window.view">
            <field name="sequence" eval="30"/>
            <field name="view_mode">form</field>
            <field name="act_window_id" ref="action_softy_departements"/>
        </record>
    </data>
</odoo>